# ── The API, twice ───────────────────────────────────────────────────────────
# The browser's route, through nginx on the public hostname.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Server components' route, over loopback. Deliberately NOT prefixed
# NEXT_PUBLIC_, so it can never be inlined into the client bundle where a
# loopback address is useless. In production this is set by ecosystem.config.js;
# locally it can point at the same place as the public one.
#
# Without it every SSR render hairpins out through nginx and back, arriving at
# the API as traffic from the box's own address — which collapses all rendering
# onto ONE rate-limit key and adds a TLS round trip per render.
INTERNAL_API_URL=http://127.0.0.1:5000/api/v1

# ── Cache invalidation ───────────────────────────────────────────────────────
# The SAME value must be in backend/.env. The backend POSTs to
# /api/internal/revalidate with it when an event is published, approved,
# suspended, cancelled or repriced; without it a just-approved event reads
# "not found" for the whole cache window, because Next stores a cached MISS
# exactly like a cached hit.
REVALIDATE_SECRET=

# ── Public identity ──────────────────────────────────────────────────────────
# Used for absolute URLs in metadata, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Supabase project's URL. The frontend NEVER queries Supabase — this is here
# only so next.config.mjs can allowlist the storage hostname for event cover
# images and add it to the CSP. There is no key here and there must never be.
NEXT_PUBLIC_SUPABASE_URL=

# ── Sign-in with Google ──────────────────────────────────────────────────────
# The client ID is public by design; the secret belongs to backend/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
