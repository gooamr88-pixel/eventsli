# ═══════════════════════════════════════════════════════════════════════════
# Eventsli API — environment
#
# Copy to `backend/.env` and fill in. NEVER commit the filled file.
# Production values live on the VPS only; they must not exist on a laptop.
#
# app.js validates the REQUIRED block at boot and exits immediately if any is
# missing — a half-configured API that starts is worse than one that refuses to.
# ═══════════════════════════════════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated. Every origin allowed to call this API with credentials.
FRONTEND_URL=http://localhost:3000
# Optional. The public site that Share & QR links point at. Unset, the FIRST
# FRONTEND_URL entry is used — never the request's Origin header.
PUBLIC_SITE_URL=
# Absolute base for links inside outgoing email (QR ticket images, etc.).
# Left unset in production, emailed images point at localhost and never load.
BACKEND_URL=http://localhost:5000

# Sign with `openssl rand -base64 48`. Two DIFFERENT secrets: a leaked QR
# secret must not also mint session tokens.
JWT_SECRET=
QR_JWT_SECRET=

# QR v2: ticket codes a check-in phone can verify with NO signal (ES256).
# Optional — without it, codes stay HS256 (QR_JWT_SECRET). Make a key with
#   node scripts/qr-signing-key.js
# and paste its two lines here. A key that is set but unreadable stops boot.
# Rotating: keep the old public key in QR_SIGNING_RETIRED_KEYS ({"kid": "PEM"})
# until its events are over. See docs/CHECKIN-APP-API.md §7.
QR_SIGNING_KID=
QR_SIGNING_KEY=
QR_SIGNING_RETIRED_KEYS=

# Check-in log retention (services/scanRetention.js, migration 20261118090000).
#   off    — default: nothing runs.
#   report — a daily dry run is logged; nothing is deleted.
#   delete — the per-scan log of events that ended more than
#            SCAN_RETENTION_DAYS ago is deleted (conflicts, open disputes and
#            held events are kept). Only after an approved dry run:
#            node scripts/scan-retention.js
SCAN_RETENTION_MODE=off
SCAN_RETENTION_DAYS=90

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing client IPs before they are stored. Rotating it anonymises
# all historical rows, which is the point.
IP_HASH_SALT=

# ── PAYMENTS ───────────────────────────────────────────────────────────────
# Stripe keys are required only when this is on, so local work needs no keys.
PAYMENTS_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
# Platform endpoint ("Your account"): application_fee.* events.
STRIPE_WEBHOOK_SECRET=
# Connect endpoint ("Connected accounts"): checkout, refunds and disputes on
# organizers own accounts. Card sales are direct charges there (T-074).
# Required whenever PAYMENTS_STRIPE_ENABLED is on.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Stripe's REAL cost to us, used to detect an under-set payment fee.
# These are not what we charge — they are what we are charged.
STRIPE_FEE_PCT=2.9
STRIPE_FEE_FIXED_CENTS=30

# ── PLATFORM DEFAULTS (admin overrides these per event) ────────────────────
# Eventsli's own cut. Independent of the payment fee. BRD §05.
DEFAULT_COMMISSION_PCT=1.5
# GST/HST charged on OUR commission, which we remit.
DEFAULT_COMMISSION_TAX_PCT=0
# The pass-through fee. Admin-set; the organizer picks who bears it. BRD §04.
DEFAULT_PAYMENT_FEE_PCT=2.9
DEFAULT_PAYMENT_FEE_FIXED_CENTS=30

# ── TICKETING ──────────────────────────────────────────────────────────────
# Must stay LONGER than the Stripe Checkout session (30 min minimum) or a buyer
# can pay for a seat that was already released and resold.
RESERVATION_TTL_MINUTES=35
DEFAULT_MAX_TICKETS_PER_ORDER=10

# ── MANUAL PAYMENT SETTLEMENT (BRD §03, §18) ───────────────────────────────
MANUAL_INVOICE_DUE_DAYS=7
# An invoice is never due later than this many hours before the event starts,
# even when the 7 days have not elapsed.
MANUAL_INVOICE_MIN_HOURS_BEFORE_EVENT=24

# ── EMAIL ──────────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_FROM_EMAIL=info@eventsli.com
BREVO_FROM_NAME=Eventsli

# ── AUTH PROVIDERS ─────────────────────────────────────────────────────────
# Unset, /auth/google refuses every token — deliberately. With no client id
# there is no `aud` to compare a token against, so "verify anyway" would accept
# every Google token in existence, including one minted for someone else's app.
GOOGLE_CLIENT_ID=

# ── OPTIONAL ───────────────────────────────────────────────────────────────
# Makes rate limits coherent across pm2 cluster workers. Without it each worker
# counts separately and the effective limit is N× and non-deterministic.
REDIS_URL=
# Must match the same value in frontend/.env so the API can purge a cached
# event page the moment the event changes.
REVALIDATE_SECRET=
# Where to send that purge: the Next server over LOOPBACK. Required in
# production — the public hostname routes /api/* back to this API, so without
# it no cached page updates on save (the API logs an error once at first use).
# Blank in development: the first FRONTEND_URL entry is used.
#   production: http://127.0.0.1:3100/api/internal/revalidate
REVALIDATE_URL=
LOG_LEVEL=info

# ── SCHEDULER ──────────────────────────────────────────────────────────────
# Background jobs: releasing abandoned holds, labelling overdue invoices,
# purging dead sessions. Off means abandoned checkouts hold their seats forever.
SCHEDULER_ENABLED=true

# ── SMS (optional; docs/SMS.md) ─────────────────────────────────────────────
# Nothing is sent until an admin verifies a country, enables a provider and
# turns sending on under SMS → Compliance. These only make that possible.
# Public API origin providers call back (receipts, replies). Falls back to
# BACKEND_URL. Must be HTTPS in production.
SMS_WEBHOOK_BASE_URL=
# Signs webhook and unsubscribe tokens. Set a dedicated random value
# (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))");
# without it they derive from JWT_SECRET, and rotating that breaks old links.
SMS_WEBHOOK_SECRET=
# Optional: lets super admins store provider credentials ENCRYPTED from the
# console (SMS → Providers). 32 random bytes, base64. Keep a copy: without the
# same key, stored credentials cannot be read back.
SMS_CREDENTIALS_KEY=
# Provider credentials. Environment values always win over stored ones.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
VONAGE_SIGNATURE_METHOD=md5hash
VONAGE_CURRENCY=EUR
# Development only: log instead of send. Ignored (with a warning) in production.
SMS_DRY_RUN=false

# ── VENUE SEARCH (optional) ────────────────────────────────────────────────
# Google Places, for the venue field in the create-event wizard. Typing three
# characters offers suggestions; choosing one fills the venue name, address,
# city, map pin and place id from a single result.
#
# OPTIONAL, AND ABSENT IS A SUPPORTED STATE. Leave it blank and the venue field
# is the plain text input it has always been — the API answers PLACES_DISABLED,
# the wizard stops asking, and nothing errors or looks broken.
#
# SERVER-SIDE ONLY. Not NEXT_PUBLIC_*: the browser never calls Google, it calls
# /api/v1/places on this API, which holds the key. That is what keeps the key
# off the public internet and keeps Google out of the frontend's CSP.
# See backend/services/placesService.js.
#
# Setup: a Google Cloud project with billing enabled, "Places API (New)"
# enabled, then an API key restricted to that one API. Restrict it by IP to
# this server — a referrer restriction does nothing for a server-side key.
GOOGLE_PLACES_API_KEY=

# Publish first, review after: every admin (role admin or super_admin) is emailed
# when an event goes live. Extra addresses to copy, comma-separated (optional).
EVENT_ALERT_EMAILS=

# ── EVENTSLI AI (optional) ─────────────────────────────────────────────────
# The Smart Event Creator: an organizer describes the event and gets a draft
# to review. See services/ai/ and docs/AI-ISSUES-LOG.md.
#
# OFF UNLESS BOTH: AI_ENABLED=true AND at least one key below. Off, the
# "Create with AI" card is simply not shown. Turning it back off is the whole
# rollback — set false, restart pm2.
#
# SERVER-SIDE ONLY, never NEXT_PUBLIC_. Two drafts per organizer per rolling
# 24 hours, counted in the database (table ai_generations); not a setting.
#
# FREE TIERS (owner decision D-019): Google's free Gemini tier may use what it
# is sent to improve its products. The describe screen and the privacy policy
# say so. Check the key works with: node scripts/probe-ai.js
AI_ENABLED=false
# Google AI Studio key. Primary provider.
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.8-flash
# GroqCloud key. Automatic fallback.
AI_GROQ_API_KEY=
AI_GROQ_MODEL=openai/gpt-oss-120b
# Try these in this order; a provider with no key is skipped.
AI_PROVIDER_ORDER=gemini,groq
# Drafting from a poster image. On with AI unless set to false. Gemini reads
# images with its normal model; Groq needs a vision model (gpt-oss cannot see).
# Set either vision model to off to keep that provider for text only.
AI_POSTER_ENABLED=true
AI_GEMINI_VISION_MODEL=
AI_GROQ_VISION_MODEL=qwen/qwen3.8-27b
# The homepage assistant (public chat). On with AI unless false; at most this
# many AI answers a day across all visitors, then it answers without AI.
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_DAILY_CAP=300
# Optional ceiling on successful drafts per 24 hours across ALL organizers.
# Blank = none. Protects the free-tier daily limits from one busy day.
AI_GLOBAL_DAILY_CAP=

# ─── Eventsli Check-in (native iOS / Android door app) ───────────────────────
# Where "Sign in with Eventsli" may send its one-time code. Comma-separated.
# Blank = the production app only (eventsli-checkin://auth/callback).
CHECKIN_APP_REDIRECT_URIS=
# Builds older than these show "Update required" instead of scanning. Raise
# only for a change the API can no longer serve the old way.
CHECKIN_APP_MIN_VERSION_IOS=1.0.0
CHECKIN_APP_MIN_VERSION_ANDROID=1.0.0
# Store listings, shown on the update screen once the app is published.
CHECKIN_APP_IOS_URL=
CHECKIN_APP_ANDROID_URL=
CHECKIN_APP_SUPPORT_URL=
