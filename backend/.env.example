# ═══════════════════════════════════════════════════════════════════════════
# Eventsli API — environment
#
# Copy to `backend/.env` and fill in. NEVER commit the filled file.
# Production values live on the VPS only; they must not exist on a laptop.
#
# app.js validates the REQUIRED block at boot and exits immediately if any is
# missing — a half-configured API that starts is worse than one that refuses to.
# ═══════════════════════════════════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated. Every origin allowed to call this API with credentials.
FRONTEND_URL=http://localhost:3000
# Absolute base for links inside outgoing email (QR ticket images, etc.).
# Left unset in production, emailed images point at localhost and never load.
BACKEND_URL=http://localhost:5000

# Sign with `openssl rand -base64 48`. Two DIFFERENT secrets: a leaked QR
# secret must not also mint session tokens.
JWT_SECRET=
QR_JWT_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing client IPs before they are stored. Rotating it anonymises
# all historical rows, which is the point.
IP_HASH_SALT=

# ── PAYMENTS ───────────────────────────────────────────────────────────────
# Stripe keys are required only when this is on, so local work needs no keys.
PAYMENTS_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Stripe's REAL cost to us, used to detect an under-set payment fee.
# These are not what we charge — they are what we are charged.
STRIPE_FEE_PCT=2.9
STRIPE_FEE_FIXED_CENTS=30

# ── PLATFORM DEFAULTS (admin overrides these per event) ────────────────────
# Eventsli's own cut. Independent of the payment fee. BRD §05.
DEFAULT_COMMISSION_PCT=1.5
# GST/HST charged on OUR commission, which we remit.
DEFAULT_COMMISSION_TAX_PCT=0
# The pass-through fee. Admin-set; the organizer picks who bears it. BRD §04.
DEFAULT_PAYMENT_FEE_PCT=2.9
DEFAULT_PAYMENT_FEE_FIXED_CENTS=30

# ── TICKETING ──────────────────────────────────────────────────────────────
# Must stay LONGER than the Stripe Checkout session (30 min minimum) or a buyer
# can pay for a seat that was already released and resold.
RESERVATION_TTL_MINUTES=35
DEFAULT_MAX_TICKETS_PER_ORDER=10

# ── MANUAL PAYMENT SETTLEMENT (BRD §03, §18) ───────────────────────────────
MANUAL_INVOICE_DUE_DAYS=7
# An invoice is never due later than this many hours before the event starts,
# even when the 7 days have not elapsed.
MANUAL_INVOICE_MIN_HOURS_BEFORE_EVENT=24

# ── EMAIL ──────────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_FROM_EMAIL=info@eventsli.com
BREVO_FROM_NAME=Eventsli

# ── AUTH PROVIDERS ─────────────────────────────────────────────────────────
# Unset, /auth/google refuses every token — deliberately. With no client id
# there is no `aud` to compare a token against, so "verify anyway" would accept
# every Google token in existence, including one minted for someone else's app.
GOOGLE_CLIENT_ID=

# ── OPTIONAL ───────────────────────────────────────────────────────────────
# Makes rate limits coherent across pm2 cluster workers. Without it each worker
# counts separately and the effective limit is N× and non-deterministic.
REDIS_URL=
# Must match the same value in frontend/.env so the API can purge a cached
# event page the moment the event changes.
REVALIDATE_SECRET=
LOG_LEVEL=info

# ── SCHEDULER ──────────────────────────────────────────────────────────────
# Background jobs: releasing abandoned holds, labelling overdue invoices,
# purging dead sessions. Off means abandoned checkouts hold their seats forever.
SCHEDULER_ENABLED=true
